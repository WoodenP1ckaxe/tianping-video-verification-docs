# 复制为 .env 后按现场要求调整。不要把生产口令提交到版本库。
TIANPING_PORT=8080
SECURE_COOKIE=false
INITIAL_PASSWORD=请替换为至少8位且包含字母与数字的一次性强口令
TRUST_PROXY=
MAX_ACTIVE_UPLOADS_PER_USER=3
MAX_ACTIVE_UPLOADS_GLOBAL=10
MAX_TEMP_UPLOAD_BYTES=2147483648
UPLOAD_SESSION_TTL_MINUTES=120
MIN_FREE_DISK_BYTES=536870912
ANALYSIS_INTERVAL_MS=600
# 本地离线 ASR：安装包/Docker 镜像已内置 whisper.cpp、Whisper 与 Silero VAD 模型。
# 默认作为必需能力；仅在做无 ASR 的源码调试时可临时设为 false。
ASR_ENABLED=true
ASR_BINARY_PATH=
ASR_MODEL_PATH=
ASR_VAD_MODEL_PATH=
ASR_LANGUAGE=zh
ASR_THREADS=2
ASR_TIMEOUT_MS=600000
ASR_MIN_CONFIDENCE=0.8
ASR_VAD_THRESHOLD=0.5
ASR_SEQUENCE_MATCH_SECONDS=20
# 历史兼容配置；当前 PDF 页面预览使用内置 PDFium WebAssembly。
PDFTOPPM_PATH=
# 默认自动搜索显示屏区域。仅在需要锁定固定机位 ROI 时填写 x,y,width,height。
DISPLAY_REGION=

